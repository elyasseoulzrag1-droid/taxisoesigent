  {
   "a": 225771,
   "b": 225788,
   "kind": "text",
   "nl": "Eén aanspreekpunt"
  },
  {
   "a": 225809,
   "b": 225919,
   "kind": "text",
   "nl": "Dezelfde chauffeur die uw afspraken kent, rechtstreeks bereikbaar per telefoon of WhatsApp, zonder callcenter."
