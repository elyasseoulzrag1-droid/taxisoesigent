  },
  {
   "a": 220800,
   "b": 220823,
   "kind": "text",
   "nl": " nodig, geen tien apps."
  },
  {
   "a": 220861,
   "b": 220994,
   "kind": "text",
   "nl": "Vaste prijzen, ritten op afroep 24 uur op 24, en één factuur op het einde van de maand. Voor uw klanten, uw gasten en uw medewerkers."
  },
  {
   "a": 221327,
   "b": 221375,
   "kind": "text",
   "nl": "\n              Vraag uw offerte aan\n            "
  },
  {
   "a": 222131,
   "b": 222164,
   "kind": "text",
   "nl": "Maandelijkse factuur, btw-conform"
  },
  {
   "a": 222341,
   "b": 222362,
   "kind": "text",
   "nl": "Vaste prijzen op maat"
  },
  {
   "a": 222539,
   "b": 222574,
   "kind": "text",
   "nl": "24/7 bereikbaar, ook in het weekend"
  },
  {
   "a": 222776,
   "b": 222788,
   "kind": "text",
   "nl": "Wat u krijgt"
  },
  {
   "a": 222805,
   "b": 222847,
   "kind": "text",
   "nl": "Vervoer dat u niet meer hoeft op te volgen"
  },
  {
   "a": 222864,
   "b": 222999,
   "kind": "text",
   "nl": "U geeft door wie waar moet zijn en wanneer. Wij regelen de chauffeur, de wagen en de opvolging, en u ziet het resultaat op één factuur."
  },
  {
   "a": 223408,
   "b": 223429,
   "kind": "text",
   "nl": "Eén factuur per maand"
  },
  {
   "a": 223450,
   "b": 223573,
   "kind": "text",
   "nl": "Alle ritten gebundeld, met datum, traject en prijs per rit. Btw-conform en klaar voor uw boekhouding. Betaling op 30 dagen."
  },
  {
   "a": 223906,
   "b": 223927,
   "kind": "text",
   "nl": "Voorrang op uw ritten"
  },
  {
   "a": 223948,
   "b": 224044,
   "kind": "text",
   "nl": "Uw aanvragen komen eerst, ook tijdens de spits, de Gentse Feesten of een beurs in Flanders Expo."
  },
  {
   "a": 224465,
   "b": 224484,
   "kind": "text",
   "nl": "Luchthaventransfers"
  },
  {
   "a": 224505,
   "b": 224618,
   "kind": "text",
   "nl": "Zaventem € 125, Charleroi € 175, all-in vanuit Gent. Vluchtopvolging inbegrepen, met VIP-onthaal voor uw klanten."
  },
  {
   "a": 225093,
   "b": 225115,
   "kind": "text",
   "nl": "Groepen tot 8 personen"
